{
  "name": "ressim",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "predev": "pnpm run build:wasm",
    "dev": "vite --host",
    "prebuild": "pnpm run build:wasm",
    "build": "vite build",
    "package:dist": "node scripts/package-dist.mjs",
    "preview": "vite preview",
    "build:wasm": "sh scripts/build-wasm.sh",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run check:cycles && pnpm run test:fast && pnpm run build",
    "pretypecheck": "pnpm run build:wasm",
    "typecheck": "tsc --noEmit",
    "check:cycles": "node scripts/check-import-cycles.mjs",
    "pretest": "pnpm run build:wasm",
    "test": "vitest run",
    "pretest:fast": "pnpm run build:wasm",
    "test:fast": "vitest run --exclude 'src/lib/catalog/scenarios/**'",
    "pretest:scenarios": "pnpm run build:wasm",
    "test:scenarios": "vitest run 'src/lib/catalog/scenarios/'",
    "pretest:watch": "pnpm run build:wasm",
    "test:watch": "vitest",
    "pretest:coverage": "pnpm run build:wasm",
    "test:coverage": "vitest run --coverage",
    "test:deployed": "playwright test",
    "lint": "eslint 'src/**/*.{js,ts,svelte}' --max-warnings=0",
    "test:rust:impes": "bash scripts/validate-solver-coverage.sh impes",
    "validate:product": "pnpm run typecheck && pnpm run lint && pnpm run check:cycles && pnpm test && pnpm run test:rust:impes && pnpm run build",
    "validate:full": "pnpm run validate:product && bash scripts/validate-solver-coverage.sh all",
    "opm:deck": "uv run --directory tools/opm_flow python -m opm_flow_tool.cli generate-deck",
    "opm:artifacts": "uv run --directory tools/opm_flow python -m opm_flow_tool.cli build-artifacts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "26.6.6",
    "@types/three": "0.186.0",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "10.6.2",
    "eslint": "10.14.0",
    "eslint-plugin-svelte": "3.23.1",
    "svelte": "5.57.3",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@ressim/analytical": "workspace:*",
    "@ressim/charts": "workspace:*",
    "@ressim/presets": "workspace:*",
    "@ressim/primitives": "workspace:*",
    "@ressim/quantities": "workspace:*",
    "chart.js": "4.6.1",
    "three": "0.186.1"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
