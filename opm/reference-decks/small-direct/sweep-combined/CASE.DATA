WBHP
/
RUNSUM
SEPARATE
SCHEDULE
RPTRST
  BASIC=2 /
WELSPECS
  'PROD' 'G' 21 21 1* 'OIL' /
  'INJ' 'G' 1 1 1* 'WATER' /
/
COMPDAT
  'PROD' 21 21 1 1 'OPEN' 2* 0.2 /
  'PROD' 21 21 2 2 'OPEN' 2* 0.2 /
  'PROD' 21 21 3 3 'OPEN' 2* 0.2 /
  'PROD' 21 21 4 4 'OPEN' 2* 0.2 /
